Screen { background: $tk-bg; color: $tk-fg; }
.masthead { height: 1; }
.masthead #logo, .masthead #nerv-logo { height: 1; margin-right: 1; }
#nerv-logo { display: none; }
.masthead Static { height: 1; }
#top { padding: 0 1; margin-bottom: 1; color: $tk-dim; }
#top .brand { color: $tk-accent; text-style: bold; width: auto; }
#status { width: 1fr; text-align: right; color: $tk-accent; }
.pane { height: 1fr; }
#panes { width: 1fr; height: 1fr; }
#panes > Vertical { height: 1fr; }
#panel-attention, #panel-epics { height: auto; max-height: 12; }
#list-attention, #list-epics { height: auto; }
.pbody { height: 1fr; }
#panel-attention .pbody, #panel-epics .pbody { height: auto; max-height: 10; }
.framed #panel-attention .pbody, .framed #panel-epics .pbody { max-height: 11; }
.panel { border: round $tk-line; border-title-color: $tk-accent; padding: 0 1; height: 1fr; width: 1fr; background: $tk-bg; }
.panel:focus-within { border: round $tk-focus; }
.filter { border: none; height: 1; padding: 0; background: $tk-bg; color: $tk-fg; margin-bottom: 1; }
.filter:focus { border: none; background: $tk-raised; }
Board { border: none; padding: 0; background: $tk-bg; height: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
Board:focus { border: none; }
Board > .option-list--option-highlighted { background: $tk-pick; text-style: none; }
Board:focus > .option-list--option-highlighted { background: $tk-pick-focus; }
Board > .option-list--option-hover { background: $tk-raised; }
Board > .option-list--option-disabled { color: $tk-dim; }
.empty { color: $tk-dim; }
Footer { background: $tk-raised; }
ConfigScreen { align: center middle; background: $tk-bg; }
#config { width: 72; height: auto; border: round $tk-accent; padding: 1 2; background: $tk-bg; }
#config .brand { color: $tk-accent; text-style: bold; }
#config .masthead { margin-bottom: 1; }
#config .label { color: $tk-dim; margin-top: 1; }
#config-buttons { height: auto; margin-top: 2; }
#config Button { margin-right: 2; }
ThemeScreen { align: center middle; background: $tk-veil; }
#themes { width: 40; height: auto; border: round $tk-accent; border-title-color: $tk-accent; border-title-style: bold; padding: 0 1;
          background: $tk-bg; }
#theme-list { height: auto; border: none; padding: 0; background: $tk-bg; }
#theme-list > .option-list--option-highlighted { background: $tk-pick-focus; text-style: none; }
.framed #themes { border: panel $tk-accent; border-title-color: $tk-title; }
ReviewScreen { align: center middle; background: $tk-veil; }
#review { width: 94%; height: 90%; border: round $tk-accent; border-title-color: $tk-accent; border-title-style: bold;
          background: $tk-bg; padding: 0 1; }
#review-list { width: 34; height: 1fr; border: none; border-right: vkey $tk-line; padding: 0; background: $tk-bg;
               text-wrap: nowrap; text-overflow: ellipsis; }
#review-list > .option-list--option-highlighted { background: $tk-pick-focus; text-style: none; }
#review-thread { width: 1fr; padding: 0 0 0 2; }
#review-place { height: auto; margin: 1 0; }
#review-diff-box { height: auto; max-height: 60%; border: round $tk-line; background: $tk-bg; overflow-x: hidden; scrollbar-gutter: stable; }
#review-diff { width: auto; }
#review-comments-box { height: 1fr; margin-top: 1; }
.framed .panel { border: none; padding: 0; margin-bottom: 1; }
.framed #panes .panel:last-child { margin-bottom: 0; }
.framed .panel .filter, .framed Board, .framed #panel-details .pbody { padding: 0 1; }
.framed #review { border: panel $tk-accent; border-title-color: $tk-title; }
#header, #header-main { height: auto; }
#elbow, #bar, #sidebar, #condition, #pills, .ptitle { display: none; }
.lcars #elbow { display: block; width: 13; height: 5; margin-bottom: 1; background: $tk-bg; }
#elbow-logo { display: none; }
.lcars #elbow-logo { display: block; overlay: screen; position: absolute; height: 2; }
.framed #top #logo { display: none; }
.framed #bar { display: block; height: 1; }
.lcars #bar { background: $tk-accent; content-align: right middle; }
.lcars #bar.-red { background: $tk-bad; }
.nerv #bar { background: $tk-bg; color: $tk-accent; }
.nerv #bar.-red { color: $tk-bad; }
#foot { dock: bottom; height: 1; }
#foot Footer { dock: none; width: 1fr; }
#footcap, #foot-cap { display: none; }
.lcars #foot-cap { display: block; width: 1; height: 1; color: $tk-accent; }
.lcars #footcap { display: block; width: 12; height: 1; margin-right: 1; background: $tk-line; }
.framed Footer { background: $tk-bg; }
.framed FooterKey { margin-right: 1; background: $tk-line; color: $tk-title; }
.framed FooterKey .footer-key--key { background: $tk-accent; color: $tk-title; }
.framed FooterKey .footer-key--description { color: $tk-title; }
.framed #top { margin: 1 0 0 0; }
.framed Tabs { display: none; }
.framed #pills { display: block; height: 1; padding: 0 1; margin: 1 0; }
.framed #panes { margin-right: 2; }
.tab-pill, .ptitle { height: 1; width: auto; }
.tab-pill { margin-right: 1; }
.tab-pill Static, .ptitle Static { width: auto; height: 1; }
.framed .ptitle { display: block; dock: top; width: 1fr; }
.lcars .pbody { border: round $tk-line; border-top: none; }
.lcars .panel:focus-within .pbody { border: round $tk-accent; border-top: none; }
.nerv .pbody { border: heavy $tk-line; border-top: none; }
.nerv .panel:focus-within .pbody { border: heavy $tk-focus; border-top: none; }
.cap { color: $tk-line; background: $tk-bg; }
.seg { background: $tk-line; color: $tk-title; text-style: bold; }
.ptitle .code, .ptitle .count { padding: 0 1; }
.ptitle .name { padding: 0 1; color: $tk-line; text-style: bold; }
.ptitle .fill { width: 1fr; }
.edge { color: $tk-line; }
.tab-pill.-on .cap, .panel:focus-within .cap, .panel:focus-within .edge { color: $tk-accent; }
.tab-pill.-on .seg, .panel:focus-within .seg { background: $tk-accent; }
.panel:focus-within .name { color: $tk-accent; }
.framed #top .brand { color: $tk-accent; }
.framed #condition { display: block; width: auto; margin-left: 2; text-style: bold; }
.lcars #sidebar { display: block; width: 12; height: 1fr; margin-right: 1; }
.side { height: 3; margin-bottom: 1; padding: 0 1; background: $tk-line; color: $tk-title; content-align: right bottom; }
.side.-on { background: $tk-accent; text-style: bold; }
#side-fill { height: 1fr; background: $tk-line; color: $tk-title; content-align: center bottom; }
.nerv .ptitle .seg, .nerv .panel:focus-within .ptitle .seg { background: $tk-bg; color: $tk-accent; }
.nerv .ptitle .name { color: $tk-accent; }
.nerv .ptitle .fill { color: $tk-line; }
.nerv .panel:focus-within .ptitle .fill, .nerv .panel:focus-within .edge { color: $tk-focus; }
.nerv .tab-pill .seg { background: $tk-bg; color: $tk-dim; }
.nerv .tab-pill.-on .seg { background: $tk-bg; color: $tk-accent; }
.nerv #review, .nerv #themes { border: heavy $tk-accent; border-title-color: $tk-accent; }
.nerv #review-diff-box { border: heavy $tk-line; }
.nerv #top #nerv-logo { display: block; }
.nerv #top .brand { display: none; }
.nerv .pane { padding: 0 1; }
.nerv #foot { padding: 0 1; }
.nerv FooterKey .footer-key--description { padding: 0 1; }
.eva01 FooterKey { background: $tk-bg; }
.eva01 FooterKey .footer-key--description { color: $tk-accent; }
