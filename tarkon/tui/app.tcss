Screen { background: $mc-bg; color: $mc-fg; }
.masthead { height: 1; }
.masthead #logo { height: 1; margin-right: 1; }
.masthead Static { height: 1; }
#top { padding: 0 1; margin-bottom: 1; color: $mc-dim; }
#top .brand { color: $mc-accent; text-style: bold; width: auto; }
#status { width: 1fr; text-align: right; color: $mc-accent; }
.pane { height: 1fr; }
#panes { width: 1fr; height: 1fr; }
#panes > Vertical { height: 1fr; }
#panel-attention, #panel-epics { height: auto; max-height: 12; }
#list-attention, #list-epics { height: auto; }
.pbody { height: 1fr; }
#panel-attention .pbody, #panel-epics .pbody { height: auto; max-height: 10; }
.lcars #panel-attention .pbody, .lcars #panel-epics .pbody { max-height: 11; }
.panel { border: round $mc-line; border-title-color: $mc-accent; padding: 0 1; height: 1fr; width: 1fr; background: $mc-bg; }
.panel:focus-within { border: round $mc-accent; }
.filter { border: none; height: 1; padding: 0; background: $mc-bg; color: $mc-fg; margin-bottom: 1; }
.filter:focus { border: none; background: $mc-raised; }
Board { border: none; padding: 0; background: $mc-bg; height: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
Board:focus { border: none; }
Board > .option-list--option-highlighted { background: $mc-pick; text-style: none; }
Board:focus > .option-list--option-highlighted { background: $mc-pick-focus; }
Board > .option-list--option-hover { background: $mc-raised; }
Board > .option-list--option-disabled { color: $mc-dim; }
.empty { color: $mc-dim; }
Footer { background: $mc-raised; }
ConfigScreen { align: center middle; background: $mc-bg; }
#config { width: 72; height: auto; border: round $mc-accent; padding: 1 2; background: $mc-bg; }
#config .brand { color: $mc-accent; text-style: bold; }
#config .masthead { margin-bottom: 1; }
#config .label { color: $mc-dim; margin-top: 1; }
#config-buttons { height: auto; margin-top: 2; }
#config Button { margin-right: 2; }
ThemeScreen { align: center middle; background: $mc-veil; }
#themes { width: 40; height: auto; border: round $mc-accent; border-title-color: $mc-accent; border-title-style: bold; padding: 0 1;
          background: $mc-bg; }
#theme-list { height: auto; border: none; padding: 0; background: $mc-bg; }
#theme-list > .option-list--option-highlighted { background: $mc-pick-focus; text-style: none; }
.lcars #themes { border: panel $mc-accent; border-title-color: $mc-title; }
ReviewScreen { align: center middle; background: $mc-veil; }
#review { width: 94%; height: 90%; border: round $mc-accent; border-title-color: $mc-accent; border-title-style: bold;
          background: $mc-bg; padding: 0 1; }
#review-list { width: 34; height: 1fr; border: none; border-right: vkey $mc-line; padding: 0; background: $mc-bg;
               text-wrap: nowrap; text-overflow: ellipsis; }
#review-list > .option-list--option-highlighted { background: $mc-pick-focus; text-style: none; }
#review-thread { width: 1fr; padding: 0 0 0 2; }
#review-place { height: auto; margin: 1 0; }
#review-diff-box { height: auto; max-height: 60%; border: round $mc-line; background: $mc-bg; overflow-x: auto; }
#review-diff { width: auto; }
#review-comments-box { height: 1fr; margin-top: 1; }
.lcars .panel { border: none; padding: 0; margin-bottom: 1; }
.lcars #panes .panel:last-child { margin-bottom: 0; }
.lcars .panel .filter, .lcars Board, .lcars #panel-details .pbody { padding: 0 1; }
.lcars #review { border: panel $mc-accent; border-title-color: $mc-title; }
#header, #header-main { height: auto; }
#elbow, #bar, #sidebar, #condition, #pills, .ptitle { display: none; }
.lcars #elbow { display: block; width: 13; height: 5; margin-bottom: 1; background: $mc-bg; }
#elbow-logo { display: none; }
.lcars #elbow-logo { display: block; overlay: screen; position: absolute; height: 2; }
.lcars #top #logo { display: none; }
.lcars #bar { display: block; height: 1; background: $mc-accent; content-align: right middle; }
.lcars #bar.-red { background: $mc-bad; }
#foot { dock: bottom; height: 1; }
#foot Footer { dock: none; width: 1fr; }
#footcap, #foot-cap { display: none; }
.lcars #foot-cap { display: block; width: 1; height: 1; color: $mc-accent; }
.lcars #footcap { display: block; width: 12; height: 1; margin-right: 1; background: $mc-line; }
.lcars Footer { background: $mc-bg; }
.lcars FooterKey { margin-right: 1; background: $mc-line; color: $mc-title; }
.lcars FooterKey .footer-key--key { background: $mc-accent; color: $mc-title; }
.lcars FooterKey .footer-key--description { color: $mc-title; }
.lcars #top { margin: 1 0 0 0; }
.lcars Tabs { display: none; }
.lcars #pills { display: block; height: 1; padding: 0 1; margin: 1 0; }
.lcars #panes { margin-right: 2; }
.tab-pill, .ptitle { height: 1; width: auto; }
.tab-pill { margin-right: 1; }
.tab-pill Static, .ptitle Static { width: auto; height: 1; }
.lcars .ptitle { display: block; dock: top; width: 1fr; }
.lcars .pbody { border: round $mc-line; border-top: none; }
.lcars .panel:focus-within .pbody { border: round $mc-accent; border-top: none; }
.cap { color: $mc-line; background: $mc-bg; }
.seg { background: $mc-line; color: $mc-title; text-style: bold; }
.ptitle .code, .ptitle .count { padding: 0 1; }
.ptitle .name { padding: 0 1; color: $mc-line; text-style: bold; }
.ptitle .fill { width: 1fr; }
.edge { color: $mc-line; }
.tab-pill.-on .cap, .panel:focus-within .cap, .panel:focus-within .edge { color: $mc-accent; }
.tab-pill.-on .seg, .panel:focus-within .seg { background: $mc-accent; }
.panel:focus-within .name { color: $mc-accent; }
.lcars #top .brand { color: $mc-accent; }
.lcars #condition { display: block; width: auto; margin-left: 2; text-style: bold; }
.lcars #sidebar { display: block; width: 12; height: 1fr; margin-right: 1; }
.side { height: 3; margin-bottom: 1; padding: 0 1; background: $mc-line; color: $mc-title; content-align: right bottom; }
.side.-on { background: $mc-accent; text-style: bold; }
#side-fill { height: 1fr; background: $mc-line; color: $mc-title; content-align: center bottom; }
